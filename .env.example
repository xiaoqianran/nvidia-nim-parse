# 复制为 .env 后填入真实值（切勿提交 .env）
NIM_API_KEY="sk-xxxx"

# NIM_ENDPOINT 为 base 地址，脚本会自动拼接 /chat/completions
# 可选（不填则用默认 NVIDIA 官方端点）
NIM_ENDPOINT="https://integrate.api.nvidia.com/v1"
NIM_MODEL="nvidia/nemotron-parse"
PDF_DIR="./pdfs"
OUT_DIR="./pdfs/md"
WORKERS="10"
DPI="200"

# ---- 扫描件预处理（仅对无文本层的扫描 PDF 生效）----
# UPSCALE   放大倍数，默认 2（扫描件直接提取内嵌原图后放大）
# BINARIZE  是否二值化去掉 JPEG 压缩噪点，默认 1；插图页可设 0
# THRESHOLD 二值化阈值（0-255），默认 160
UPSCALE="2"
BINARIZE="1"
THRESHOLD="160"
